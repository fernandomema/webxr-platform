		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@wuchale/svelte": "^0.21.4",
		"better-auth": "^1.7.6",
		"dotenv": "^18.0.4",
		"monaco-editor": "^0.52.2",
