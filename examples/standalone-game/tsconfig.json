{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		// The engine is shipped as TypeScript source, whose imports name their .ts files.
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": true,
		"moduleResolution": "bundler"
	}
}
