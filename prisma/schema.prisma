generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- better-auth ---

model user {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean   @default(false)
  image           String?
  username        String?
  displayUsername String?
  /// Short shareable code others type to send this person a friend request. Created on first use.
  friendCode      String?
  role            String?
  banned          Boolean?  @default(false)
  banReason       String?
  banExpires      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        session[]
  accounts        account[]
  worlds          world[]
  publications    publishedWorld[]
  leaderboardEntries leaderboardEntry[]
  marketplaceItems marketplaceItem[]
  marketplacePurchases marketplacePurchase[]
  cloudItems      cloudInventoryItem[]
  cloudFolders    cloudInventoryFolder[]
  worldPlayerItems worldPlayerItem[]
  assetOwnerships assetOwner[]
  feedbackVotes feedbackVote[]
  feedbackEntries feedbackEntry[]
  feedbackInteractions feedbackInteraction[]
  feedbackMoodResponses feedbackMoodResponse[]
  worldVisits worldVisit[]
  aiRuns aiRun[]
  creditAccount creditAccount?
  creditTransactions creditTransaction[]
  productEntitlements productEntitlement[]
  paymentIdentities paymentIdentity[]
  friendshipsAsA  friendship[] @relation("friendshipA")
  friendshipsAsB  friendship[] @relation("friendshipB")
  friendRequestsSent friendRequest[] @relation("friendRequestFrom")
  friendRequestsReceived friendRequest[] @relation("friendRequestTo")
  blocksMade      userBlock[] @relation("blocker")
  blocksReceived  userBlock[] @relation("blocked")
  externalFriendLinks externalFriendLink[]

  @@unique([email])
  @@unique([username])
  // Not unique yet: the column is new and unique constraints make `db push` warn. Codes are checked for collisions in code
  // (services/friends.ts); make this `@@unique([friendCode])` in a later push once every deployment has the column.
  @@index([friendCode])
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  impersonatedBy String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Sign-in for a game that lives on another site or on a headset: it shows a code, the player approves it on the platform's /device page.
model deviceCode {
  id              String    @id
  deviceCode      String
  userCode        String
  userId          String?
  expiresAt       DateTime
  status          String
  lastPolledAt    DateTime?
  pollingInterval Int?
  clientId        String?
  scope           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([deviceCode])
  @@unique([userCode])
}

// --- worlds / hosting ---

model world {
  id         String   @id @default(cuid())
  name       String
  visibility String   @default("private") // private | public (friend scopes require access-control infrastructure)
  hostUserId String
  hostUser   user     @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  sceneData  Json // serialized Slot tree template (see src/lib/ecs)
  /// The world's 360° preview (an `image` asset), made by the host after it starts hosting. Null until then.
  thumbnailAssetId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions        worldSession[]
  worldInventory  worldInventoryItem[]
  worldFolders    worldInventoryFolder[]

  @@index([hostUserId])
  assets           worldAsset[]
}

model worldSession {
  id         String    @id @default(cuid())
  worldId    String
  world      world     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  hostUserId String
  roomCode   String    @unique
  /// The published world this session runs, when it was launched from one. Guests only ever store data for this publication.
  publicationId String?
  startedAt  DateTime  @default(now())
  endedAt    DateTime? // null = currently active

  @@index([worldId])
  @@index([endedAt])
}

// --- inventory: cloud + world backends (local backend lives in browser IndexedDB) ---
// Folders form a tree per owner/world (parentId null = that root's own top level).

model cloudInventoryFolder {
  id        String                 @id @default(cuid())
  ownerId   String
  owner     user                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    cloudInventoryFolder?  @relation("CloudFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  cloudInventoryFolder[] @relation("CloudFolderChildren")
  name      String
  /// private | public. A public folder makes every item and folder inside it readable by anyone who knows the item's id.
  visibility String                @default("private")
  createdAt DateTime               @default(now())
  items     cloudInventoryItem[]

  @@index([ownerId])
  @@index([parentId])
}

model cloudInventoryItem {
  id           String                @id @default(cuid())
  ownerId      String
  owner        user                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       cloudInventoryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name         String
  slotData     Json
  kind         String                @default("object")
  /// private | public. Public lets anyone who knows the id read it (never listed); a public folder above it has the same effect.
  visibility   String                @default("private")
  worldLineageId String?
  revisionNumber Int?
  thumbnailAssetId String?
  createdAt    DateTime              @default(now())

  @@index([ownerId])
  @@index([folderId])
  @@unique([ownerId, worldLineageId, revisionNumber])
  assets           cloudItemAsset[]
  marketplaceItemId String?
  marketplaceItem marketplaceItem? @relation(fields: [marketplaceItemId], references: [id], onDelete: SetNull)
  @@index([marketplaceItemId])
}

model worldInventoryFolder {
  id        String                 @id @default(cuid())
  worldId   String
  world     world                  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    worldInventoryFolder?  @relation("WorldFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  worldInventoryFolder[] @relation("WorldFolderChildren")
  name      String
  createdAt DateTime               @default(now())
  items     worldInventoryItem[]

  @@index([worldId])
  @@index([parentId])
}

model worldInventoryItem {
  id           String                @id @default(cuid())
  worldId      String
  world        world                 @relation(fields: [worldId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       worldInventoryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name         String
  slotData     Json
  kind         String                @default("object")
  worldLineageId String?
  revisionNumber Int?
  thumbnailAssetId String?
  createdAt    DateTime              @default(now())

  @@index([worldId])
  @@index([folderId])
  @@unique([worldId, worldLineageId, revisionNumber])
  assets           worldInventoryItemAsset[]
  marketplaceItemId String?
  marketplaceItem marketplaceItem? @relation(fields: [marketplaceItemId], references: [id], onDelete: SetNull)
  @@index([marketplaceItemId])
}

// Published worlds are independent from live sessions and from inventory drafts.
// Each revision is immutable; a portal can pin a precise revision.
model publishedWorld {
  id               String @id @default(cuid())
  ownerId          String
  owner            user @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// 'world' is a world people play. 'app' is the identity of a game built on the engine whose levels ship with the game itself (so there
  /// can be hundreds): it owns the storage, leaderboards and shop those levels share. Its one revision holds only the shop; it is never listed or played.
  kind             String @default("world")
  /// For an app: the sites it runs on, which may call the API with a bearer token (exact origins).
  origins          String[] @default([])
  name             String
  latestRevision   Int @default(1)
  /// The 360° preview (an `image` asset) of the latest revision, when it has one.
  thumbnailAssetId String?
  /// Highlighted by staff on the home screen. Set with `scripts/staff-pick.mjs`.
  staffPick        Boolean @default(false)
  visits           worldVisit[]
  revisions        publishedWorldRevision[]
  storageEntries   worldStorageEntry[]
  playerItems      worldPlayerItem[]
  leaderboards     leaderboard[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId])
  @@index([staffPick])
  @@index([kind])
}

/// One row per user and published world: when they last opened it (feeds "Recently visited" on the home screen).
model worldVisit {
  userId        String
  user          user @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicationId String
  publication   publishedWorld @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  visitedAt     DateTime @default(now())

  @@id([userId, publicationId])
  @@index([userId, visitedAt])
}

model publishedWorldRevision {
  id               String @id @default(cuid())
  publicationId    String
  publication      publishedWorld @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  number           Int
  sceneData        Json
  createdAt        DateTime @default(now())

  @@unique([publicationId, number])
  assets           publishedRevisionAsset[]
}

// Marketplace objects are independent from the inventory entry they were published from.
model marketplaceItem {
  id             String @id @default(cuid())
  ownerId        String
  owner          user @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  description    String @default("")
  thumbnailAssetId   String?
  latestRevision Int @default(1)
  status         String @default("published") // published | hidden
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  revisions      marketplaceItemRevision[]
  purchases      marketplacePurchase[]
  cloudItems     cloudInventoryItem[]
  worldItems     worldInventoryItem[]

  @@index([ownerId])
  @@index([status, updatedAt])
}

model marketplaceItemRevision {
  id                 String @id @default(cuid())
  marketplaceItemId  String
  marketplaceItem    marketplaceItem @relation(fields: [marketplaceItemId], references: [id], onDelete: Cascade)
  number             Int
  slotData           Json
  createdAt          DateTime @default(now())
  assets             marketplaceRevisionAsset[]

  @@unique([marketplaceItemId, number])
}

model marketplacePurchase {
  id                String @id @default(cuid())
  userId            String
  user              user @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplaceItemId String
  marketplaceItem   marketplaceItem @relation(fields: [marketplaceItemId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([userId, marketplaceItemId])
  @@index([marketplaceItemId])
}

// --- 3D model assets -------------------------------------------------------
// One row per distinct file, keyed by the SHA-256 of its bytes; the file itself
// lives once in object storage. Many users can own the same asset (each is
// charged its full size), and scenes reference it, so an asset nobody owns and
// nothing references can be found and cleaned up.

model asset {
  id                String    @id // "sha256:<64 hex>"
  byteSize          Int
  mimeType          String
  format            String
  manifest          Json
  storageKey        String    @unique
  status            String    @default("pending") // pending | ready
  createdAt         DateTime  @default(now())
  readyAt           DateTime?
  firstUploadedById String?
  /// Set when the last owner and the last reference are gone; cleared if someone claims it again.
  orphanedAt        DateTime?

  owners            assetOwner[]
  cloudItems        cloudItemAsset[]
  worldItems        worldInventoryItemAsset[]
  revisions         publishedRevisionAsset[]
  marketplaceRevisions marketplaceRevisionAsset[]
  worlds            worldAsset[]
  playerItems       worldPlayerItemAsset[]

  @@index([status, createdAt])
  @@index([orphanedAt])
}

model assetOwner {
  assetId   String
  ownerId   String
  name      String
  source    String   @default("upload") // upload | reupload | clone
  createdAt DateTime @default(now())

  asset     asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  owner     user     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([assetId, ownerId])
  @@index([ownerId])
}

model cloudItemAsset {
  itemId  String
  assetId String
  item    cloudInventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  asset   asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([itemId, assetId])
  @@index([assetId])
}

model worldInventoryItemAsset {
  itemId  String
  assetId String
  item    worldInventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  asset   asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([itemId, assetId])
  @@index([assetId])
}

model publishedRevisionAsset {
  revisionId String
  assetId    String
  revision   publishedWorldRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  asset      asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([revisionId, assetId])
  @@index([assetId])
}

model marketplaceRevisionAsset {
  revisionId String
  assetId    String
  revision   marketplaceItemRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  asset      asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([revisionId, assetId])
  @@index([assetId])
}

// Objects (slot trees with the models they use) a published world keeps for the person who hosts it, in the cloud. They are that
// account's, not the world creator's: they count in the account's storage. The same objects can instead be kept on the device.
model worldPlayerItem {
  id               String   @id @default(cuid())
  publicationId    String
  publication      publishedWorld @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  accountId        String
  account          user     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// The name a script saved it under, the same for every host. Null for objects saved from the Dash.
  key              String?
  name             String
  slotData         Json
  thumbnailAssetId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  assets           worldPlayerItemAsset[]

  @@unique([publicationId, accountId, key])
  @@index([accountId])
}

model worldPlayerItemAsset {
  itemId  String
  assetId String
  item    worldPlayerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  asset   asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([itemId, assetId])
  @@index([assetId])
}

model worldAsset {
  worldId String
  assetId String
  world   world @relation(fields: [worldId], references: [id], onDelete: Cascade)
  asset   asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([worldId, assetId])
  @@index([assetId])
}

// Feedback Center: shared across all copies and hosted sessions.
model feedbackEntry {
  id        String @id @default(cuid())
  userId    String
  user      user @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions feedbackInteraction[]
  userVotes feedbackVote[]
  category  String // idea | bug | other
  title     String
  titleKey  String
  votes     Int @default(0)
  status    String @default("pending") // pending | planned | progress | shipped
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, titleKey])
  @@index([category, votes])
  @@index([userId])
}

model feedbackMood {
  key   String @id // loving | good | meh | needs-work
  count Int @default(0)
}

// Records every submission and vote, including submissions matching an existing title.
model feedbackInteraction {
  id        String @id @default(cuid())
  entryId   String
  entry     feedbackEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  user      user @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // suggest | vote
  delta     Int
  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([userId])
}

model feedbackMoodResponse {
  id        String @id @default(cuid())
  key       String // loving | good | meh | needs-work
  userId    String
  user      user @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([key])
  @@index([userId])
}

model feedbackVote {
  entryId String
  entry feedbackEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId String
  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
  value Int // 1 | -1
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([entryId, userId])
  @@index([userId])
}

// Persistent data of a published world. Keyed by the publication (not a revision), so publishing an update keeps it.
// scope 'world' rows are shared by every session (accountId is '', so it has no foreign key; player rows are removed with the publication); scope 'player' rows belong to one account.
model worldStorageEntry {
  publicationId String
  publication   publishedWorld @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  scope         String // world | player
  accountId     String @default("")
  key           String
  value         Json
  version       Int @default(1)
  updatedAt     DateTime @updatedAt

  @@id([publicationId, scope, accountId, key])
  @@index([accountId])
}

// Created by the first submit to a name. `order` decides which score wins: 'high' (points) or 'low' (times).
model leaderboard {
  id            String @id @default(cuid())
  publicationId String
  publication   publishedWorld @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  name          String
  order         String // high | low
  seasonId      String @default("")
  entries       leaderboardEntry[]
  createdAt     DateTime @default(now())

  @@unique([publicationId, name, seasonId])
}

model leaderboardEntry {
  leaderboardId String
  leaderboard   leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  accountId     String
  account       user @relation(fields: [accountId], references: [id], onDelete: Cascade)
  displayName   String
  score         Float
  updatedAt     DateTime @updatedAt

  @@id([leaderboardId, accountId])
  @@index([leaderboardId, score])
  @@index([accountId])
}

// --- credits ---------------------------------------------------------------
// The balance only moves through creditTransaction rows (see services/credits.ts): every change writes one with a unique
// idempotencyKey, so a retried request, a replayed challenge or a repeated webhook can never apply twice.

model creditAccount {
  userId    String @id
  user      user @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int @default(0)
  updatedAt DateTime @updatedAt
}

model creditTransaction {
  id             String @id @default(cuid())
  userId         String
  user           user @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Positive when credits arrive (purchase, grant, refund), negative when they are spent.
  delta          Int
  balanceAfter   Int
  kind           String // purchase | spend | refund | grant
  /// Where it came from: a payment provider ('stripe', 'meta') for purchases, 'world' for spending in a published world.
  provider       String?
  providerRef    String?
  publicationId  String?
  sku            String?
  idempotencyKey String @unique
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  @@index([publicationId, createdAt])
}

/// What a player has bought in a published world: kept per publication and product code, so publishing an update keeps it.
model productEntitlement {
  userId        String
  user          user @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicationId String
  sku           String
  /// How many times it was bought (a consumable can be bought again).
  quantity      Int @default(1)
  updatedAt     DateTime @updatedAt

  @@id([userId, publicationId, sku])
  @@index([publicationId])
}

/// Which of our accounts a store account (Meta) has paid for. The first verified purchase links them; after that, receipts that name
/// that store account only credit this player, so a receipt cannot be pointed at someone else's store account.
model paymentIdentity {
  provider   String
  externalId String
  userId     String
  user       user @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([provider, externalId])
  @@index([userId])
}

// --- platform AI -----------------------------------------------------------
// One aiRun per request a person sends to the platform's own AI, one aiCall per model call inside it. They hold usage numbers
// only (never prompts or answers), so real costs can be studied before prices are set. `tariffVersion` says which price list and
// budget applied, so old runs can be re-priced later.

model aiRun {
  id              String    @id
  userId          String
  user            user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  model           String
  /// running | completed | stopped | loop | budget | error. A run that stays 'running' was abandoned (tab closed).
  status          String    @default("running")
  /// ask | edit | create | complex, derived from the tools the agent used.
  task            String?
  /// True when nothing is charged (development, or the free calibration phase).
  free            Boolean
  /// What the run was expected to cost when it started (the button's estimate); the fallback charge when rates cannot be read at settle time.
  quotedCredits   Int       @default(0)
  /// What the run actually charged when it settled (0 for free runs and unanswered ones).
  credits         Int       @default(0)
  refunded        Boolean   @default(false)
  tariffVersion   String
  calls           Int       @default(0)
  okCalls         Int       @default(0)
  steps           Int?
  toolCalls       Int?
  inputTokens     Int       @default(0)
  outputTokens    Int       @default(0)
  cacheReadTokens Int       @default(0)
  cacheWriteTokens Int      @default(0)
  durationMs      Int?
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?
  aiCalls         aiCall[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([model, createdAt])
}

model aiCall {
  id              String   @id @default(cuid())
  runId           String
  run             aiRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  provider        String
  model           String
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  cacheReadTokens Int      @default(0)
  cacheWriteTokens Int     @default(0)
  latencyMs       Int
  /// HTTP status the provider answered with (0 when it could not be reached).
  status          Int
  error           String?
  createdAt       DateTime @default(now())

  @@index([runId])
  @@index([createdAt])
}

// --- friends ----------------------------------------------------------------
// A confirmed friendship is one row per pair with the ids in sorted order (userAId < userBId), so the pair is unique whichever
// side asked. Requests, blocks and links to platform accounts (Meta Quest, later Steam) sit beside it.
model friendship {
  userAId   String
  userA     user     @relation("friendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     user     @relation("friendshipB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userAId, userBId])
  @@index([userBId])
}

model friendRequest {
  id          String    @id @default(cuid())
  fromUserId  String
  from        user      @relation("friendRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  to          user      @relation("friendRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  /// Only open requests are kept: accepting, declining or cancelling deletes the row.
  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

model userBlock {
  blockerId String
  blocker   user     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   user     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// An account of a platform's friend graph (Meta Quest user id, later a Steam id) proven to belong to a person here.
model externalFriendLink {
  provider   String
  externalId String
  userId     String
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([provider, externalId])
  @@unique([provider, userId])
  @@index([userId])
}

/// Errors and warnings players' browsers report in production (see $lib/clientErrorReporter.ts), grouped by what they say so that a
/// failure many players hit is one row with a count. Players can switch the sending off in their settings. `lastUserId` is not a relation:
/// deleting an account must not depend on, or leave behind, anything here.
model clientError {
  id          String   @id @default(cuid())
  /// Hash of the level, message and first stack line, with numbers and ids removed (see clientErrorInput.ts).
  fingerprint String   @unique
  level       String // error | warn
  message     String
  stack       String?
  /// Where it was seen: the path only, never the query or hash.
  path        String
  userAgent   String?
  /// Of the last report: see deviceInfo.ts. Best effort; browsers hide the model on purpose.
  platform    String?
  device      String?
  /// How many reports came from each device: { "Quest 3": 5, "Desktop": 2 }.
  devices     Json?
  count       Int      @default(1)
  lastUserId  String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  resolved    Boolean  @default(false)

  @@index([lastSeenAt])
  @@index([resolved, lastSeenAt])
}
