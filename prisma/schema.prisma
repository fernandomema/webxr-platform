generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- better-auth ---

model user {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean   @default(false)
  image           String?
  username        String?
  displayUsername String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        session[]
  accounts        account[]
  worlds          world[]
  publications    publishedWorld[]
  marketplaceItems marketplaceItem[]
  marketplacePurchases marketplacePurchase[]
  cloudItems      cloudInventoryItem[]
  cloudFolders    cloudInventoryFolder[]
  assetOwnerships assetOwner[]
  feedbackVotes feedbackVote[]
  feedbackEntries feedbackEntry[]
  feedbackInteractions feedbackInteraction[]
  feedbackMoodResponses feedbackMoodResponse[]

  @@unique([email])
  @@unique([username])
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// --- worlds / hosting ---

model world {
  id         String   @id @default(cuid())
  name       String
  visibility String   @default("private") // private | public (friend scopes require access-control infrastructure)
  hostUserId String
  hostUser   user     @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  sceneData  Json // serialized Slot tree template (see src/lib/ecs)
  /// The world's 360° preview (an `image` asset), made by the host after it starts hosting. Null until then.
  thumbnailAssetId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions        worldSession[]
  worldInventory  worldInventoryItem[]
  worldFolders    worldInventoryFolder[]

  @@index([hostUserId])
  assets           worldAsset[]
}

model worldSession {
  id         String    @id @default(cuid())
  worldId    String
  world      world     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  hostUserId String
  roomCode   String    @unique
  startedAt  DateTime  @default(now())
  endedAt    DateTime? // null = currently active

  @@index([worldId])
  @@index([endedAt])
}

// --- inventory: cloud + world backends (local backend lives in browser IndexedDB) ---
// Folders form a tree per owner/world (parentId null = that root's own top level).

model cloudInventoryFolder {
  id        String                 @id @default(cuid())
  ownerId   String
  owner     user                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    cloudInventoryFolder?  @relation("CloudFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  cloudInventoryFolder[] @relation("CloudFolderChildren")
  name      String
  createdAt DateTime               @default(now())
  items     cloudInventoryItem[]

  @@index([ownerId])
  @@index([parentId])
}

model cloudInventoryItem {
  id           String                @id @default(cuid())
  ownerId      String
  owner        user                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       cloudInventoryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name         String
  slotData     Json
  kind         String                @default("object")
  worldLineageId String?
  revisionNumber Int?
  thumbnailAssetId String?
  createdAt    DateTime              @default(now())

  @@index([ownerId])
  @@index([folderId])
  @@unique([ownerId, worldLineageId, revisionNumber])
  assets           cloudItemAsset[]
  marketplaceItemId String?
  marketplaceItem marketplaceItem? @relation(fields: [marketplaceItemId], references: [id], onDelete: SetNull)
  @@index([marketplaceItemId])
}

model worldInventoryFolder {
  id        String                 @id @default(cuid())
  worldId   String
  world     world                  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    worldInventoryFolder?  @relation("WorldFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  worldInventoryFolder[] @relation("WorldFolderChildren")
  name      String
  createdAt DateTime               @default(now())
  items     worldInventoryItem[]

  @@index([worldId])
  @@index([parentId])
}

model worldInventoryItem {
  id           String                @id @default(cuid())
  worldId      String
  world        world                 @relation(fields: [worldId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       worldInventoryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name         String
  slotData     Json
  kind         String                @default("object")
  worldLineageId String?
  revisionNumber Int?
  thumbnailAssetId String?
  createdAt    DateTime              @default(now())

  @@index([worldId])
  @@index([folderId])
  @@unique([worldId, worldLineageId, revisionNumber])
  assets           worldInventoryItemAsset[]
  marketplaceItemId String?
  marketplaceItem marketplaceItem? @relation(fields: [marketplaceItemId], references: [id], onDelete: SetNull)
  @@index([marketplaceItemId])
}

// Published worlds are independent from live sessions and from inventory drafts.
// Each revision is immutable; a portal can pin a precise revision.
model publishedWorld {
  id               String @id @default(cuid())
  ownerId          String
  owner            user @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name             String
  latestRevision   Int @default(1)
  /// The 360° preview (an `image` asset) of the latest revision, when it has one.
  thumbnailAssetId String?
  revisions        publishedWorldRevision[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId])
}

model publishedWorldRevision {
  id               String @id @default(cuid())
  publicationId    String
  publication      publishedWorld @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  number           Int
  sceneData        Json
  createdAt        DateTime @default(now())

  @@unique([publicationId, number])
  assets           publishedRevisionAsset[]
}

// Marketplace objects are independent from the inventory entry they were published from.
model marketplaceItem {
  id             String @id @default(cuid())
  ownerId        String
  owner          user @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  description    String @default("")
  thumbnailAssetId   String?
  latestRevision Int @default(1)
  status         String @default("published") // published | hidden
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  revisions      marketplaceItemRevision[]
  purchases      marketplacePurchase[]
  cloudItems     cloudInventoryItem[]
  worldItems     worldInventoryItem[]

  @@index([ownerId])
  @@index([status, updatedAt])
}

model marketplaceItemRevision {
  id                 String @id @default(cuid())
  marketplaceItemId  String
  marketplaceItem    marketplaceItem @relation(fields: [marketplaceItemId], references: [id], onDelete: Cascade)
  number             Int
  slotData           Json
  createdAt          DateTime @default(now())
  assets             marketplaceRevisionAsset[]

  @@unique([marketplaceItemId, number])
}

model marketplacePurchase {
  id                String @id @default(cuid())
  userId            String
  user              user @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplaceItemId String
  marketplaceItem   marketplaceItem @relation(fields: [marketplaceItemId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([userId, marketplaceItemId])
  @@index([marketplaceItemId])
}

// --- 3D model assets -------------------------------------------------------
// One row per distinct file, keyed by the SHA-256 of its bytes; the file itself
// lives once in object storage. Many users can own the same asset (each is
// charged its full size), and scenes reference it, so an asset nobody owns and
// nothing references can be found and cleaned up.

model asset {
  id                String    @id // "sha256:<64 hex>"
  byteSize          Int
  mimeType          String
  format            String
  manifest          Json
  storageKey        String    @unique
  status            String    @default("pending") // pending | ready
  createdAt         DateTime  @default(now())
  readyAt           DateTime?
  firstUploadedById String?
  /// Set when the last owner and the last reference are gone; cleared if someone claims it again.
  orphanedAt        DateTime?

  owners            assetOwner[]
  cloudItems        cloudItemAsset[]
  worldItems        worldInventoryItemAsset[]
  revisions         publishedRevisionAsset[]
  marketplaceRevisions marketplaceRevisionAsset[]
  worlds            worldAsset[]

  @@index([status, createdAt])
  @@index([orphanedAt])
}

model assetOwner {
  assetId   String
  ownerId   String
  name      String
  source    String   @default("upload") // upload | reupload | clone
  createdAt DateTime @default(now())

  asset     asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  owner     user     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([assetId, ownerId])
  @@index([ownerId])
}

model cloudItemAsset {
  itemId  String
  assetId String
  item    cloudInventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  asset   asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([itemId, assetId])
  @@index([assetId])
}

model worldInventoryItemAsset {
  itemId  String
  assetId String
  item    worldInventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  asset   asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([itemId, assetId])
  @@index([assetId])
}

model publishedRevisionAsset {
  revisionId String
  assetId    String
  revision   publishedWorldRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  asset      asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([revisionId, assetId])
  @@index([assetId])
}

model marketplaceRevisionAsset {
  revisionId String
  assetId    String
  revision   marketplaceItemRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  asset      asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([revisionId, assetId])
  @@index([assetId])
}

model worldAsset {
  worldId String
  assetId String
  world   world @relation(fields: [worldId], references: [id], onDelete: Cascade)
  asset   asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([worldId, assetId])
  @@index([assetId])
}

// Feedback Center: shared across all copies and hosted sessions.
model feedbackEntry {
  id        String @id @default(cuid())
  userId    String
  user      user @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions feedbackInteraction[]
  userVotes feedbackVote[]
  category  String // idea | bug | other
  title     String
  titleKey  String
  votes     Int @default(0)
  status    String @default("pending") // pending | planned | progress | shipped
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, titleKey])
  @@index([category, votes])
  @@index([userId])
}

model feedbackMood {
  key   String @id // loving | good | meh | needs-work
  count Int @default(0)
}

// Records every submission and vote, including submissions matching an existing title.
model feedbackInteraction {
  id        String @id @default(cuid())
  entryId   String
  entry     feedbackEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  user      user @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // suggest | vote
  delta     Int
  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([userId])
}

model feedbackMoodResponse {
  id        String @id @default(cuid())
  key       String // loving | good | meh | needs-work
  userId    String
  user      user @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([key])
  @@index([userId])
}

model feedbackVote {
  entryId String
  entry feedbackEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId String
  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
  value Int // 1 | -1
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([entryId, userId])
  @@index([userId])
}
