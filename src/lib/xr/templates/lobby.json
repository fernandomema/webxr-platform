				"background": "#0f172a"
			},
			{
				"type": "codeBlock",
				"code": "const API = 'https://api.piped.private.coffee';\nconst ROWS = 10;\nlet query = '';\nlet results = [];\nlet token = 0;\nlet ids = null;\nlet candidates = [];\nlet candidate = 0;\nlet lastText = '';\nlet lastBroadcast = 0;\nlet sinceCheck = 0;\n\nfunction collect(parentId, out) {\n\tfor (const child of ctx.hierarchy.getChildren(parentId)) {\n\t\tout[child.name] = child.id;\n\t\tcollect(child.id, out);\n\t}\n\treturn out;\n}\nfunction id(name) {\n\tif (!ids || !ids[name]) ids = collect(ctx.self.id, {});\n\treturn ids[name];\n}\nfunction ui(slotId) {\n\tconst slot = slotId && ctx.hierarchy.getSlot(slotId);\n\treturn slot && slot.components.find((c) => c.type === 'uiElement');\n}\nfunction set(name, field, value, broadcast) {\n\tconst slotId = id(name);\n\tif (slotId) ctx.world.setComponentField(slotId, 'uiElement', field, value, broadcast !== false);\n}\nfunction clock(seconds) {\n\tconst total = Math.max(0, Math.floor(seconds || 0));\n\treturn Math.floor(total / 60) + ':' + String(total % 60).padStart(2, '0');\n}\n\nasync function search(text) {\n\ttext = (text || '').trim();\n\tctx.log('search', text);\n\tif (!text) return set('YT Status', 'text', 'Type something to search first.');\n\tconst mine = ++token;\n\tset('YT Status', 'text', 'Searching...');\n\ttry {\n\t\tconst data = await ctx.net.fetchJson(API + '/search?q=' + encodeURIComponent(text) + '&filter=videos');\n\t\tif (mine !== token) return;\n\t\tresults = (data.items || []).filter((item) => item.type === 'stream').slice(0, ROWS);\n\t\tfor (let i = 0; i < ROWS; i++) {\n\t\t\tconst item = results[i];\n\t\t\tset('YT Row ' + i, 'visible', Boolean(item), false);\n\t\t\tset('YT Thumb ' + i, 'src', item ? item.thumbnail : '', false);\n\t\t\tset('YT Pick ' + i, 'text', item ? item.title + '\\n' + item.uploaderName + ' - ' + clock(item.duration) : '', false);\n\t\t}\n\t\tset('YT Status', 'text', results.length ? results.length + ' results' : 'No results');\n\t} catch (error) {\n\t\tset('YT Status', 'text', 'Search failed: ' + error.message);\n\t}\n}\n\nfunction useCandidate() {\n\tset('YT Video', 'src', candidates[candidate].url, false);\n\tset('YT Video', 'currentTime', 0, false);\n\tset('YT Video', 'playing', true, false);\n\tset('YT Play', 'text', 'Pause', false);\n}\n\nasync function play(item) {\n\tconst mine = ++token;\n\tset('YT Now', 'text', 'Loading ' + item.title + '...');\n\ttry {\n\t\tconst videoId = item.url.split('v=')[1];\n\t\tconst data = await ctx.net.fetchJson(API + '/streams/' + videoId);\n\t\tif (mine !== token) return;\n\t\tif (data.error) throw new Error(String(data.message || data.error).split('\\n')[0].slice(0, 90));\n\t\tcandidates = (data.videoStreams || []).filter((s) => s.mimeType === 'video/mp4' && s.videoOnly === false && s.quality !== 'LBRY');\n\t\tif (!candidates.length) throw new Error('no playable stream');\n\t\tcandidate = 0;\n\t\tuseCandidate();\n\t\tset('YT Now', 'text', data.title || item.title);\n\t} catch (error) {\n\t\tset('YT Now', 'text', 'Could not play: ' + error.message);\n\t}\n}\n\nfunction seek(delta) {\n\tconst media = ctx.ui.getMedia(id('YT Video'));\n\tif (!media || !media.ready) return;\n\tconst end = media.duration || Infinity;\n\tset('YT Video', 'currentTime', Math.min(end, Math.max(0, media.currentTime + delta)));\n}\n\nfunction toggle(name, field, onLabel, offLabel, labelName) {\n\tconst element = ui(id(name));\n\tif (!element) return;\n\tconst next = !element[field];\n\tset(name, field, next, false);\n\tif (labelName) set(labelName, 'text', next ? onLabel : offLabel);\n\telse ctx.world.setComponentField(id(name), 'uiElement', field, next);\n}\n\nreturn {\n\tonUIEvent(e) {\n\t\tif (!ctx.world.isHost()) return;\n\t\tif (e.slotId === id('YT Input') && (e.type === 'change' || e.type === 'submit')) query = e.text || '';\n\t\tif (e.slotId === id('YT Input') && e.type === 'submit') return search(query);\n\t\tif (e.type !== 'press') return;\n\t\tif (e.slotId === id('YT Search')) return search(ctx.ui.getInputText(id('YT Input')) || query);\n\t\tif (e.slotId === id('YT Play')) return toggle('YT Video', 'playing', 'Pause', 'Play', 'YT Play');\n\t\tif (e.slotId === id('YT Back')) return seek(-10);\n\t\tif (e.slotId === id('YT Forward')) return seek(10);\n\t\tif (e.slotId === id('YT Mute')) return toggle('YT Video', 'muted', 'Unmute', 'Mute', 'YT Mute');\n\t\tfor (let i = 0; i < ROWS; i++) {\n\t\t\tif (e.slotId === id('YT Pick ' + i) && results[i]) return play(results[i]);\n\t\t}\n\t},\n\ttick(dt) {\n\t\tif (!ctx.world.isHost()) return;\n\t\tsinceCheck += dt;\n\t\tif (sinceCheck < 0.5) return;\n\t\tsinceCheck = 0;\n\t\tconst media = ctx.ui.getMedia(id('YT Video'));\n\t\tif (media && media.error && candidates.length) {\n\t\t\t// The browser could not load this stream: fall through to the next one the API listed.\n\t\t\tif (candidate < candidates.length - 1) {\n\t\t\t\tcandidate++;\n\t\t\t\tuseCandidate();\n\t\t\t\tset('YT Status', 'text', 'Stream failed, trying alternative ' + (candidate + 1) + ' of ' + candidates.length);\n\t\t\t} else {\n\t\t\t\tcandidates = [];\n\t\t\t\tset('YT Video', 'playing', false, false);\n\t\t\t\tset('YT Status', 'text', 'None of the streams could be loaded.');\n\t\t\t}\n\t\t\treturn;\n\t\t}\n\t\tif (!media || !media.ready) return;\n\t\tconst video = ui(id('YT Video'));\n\t\tif (media.ended && video && video.playing && !video.loop) {\n\t\t\tset('YT Video', 'playing', false, false);\n\t\t\tset('YT Play', 'text', 'Play');\n\t\t}\n\t\tconst text = clock(media.currentTime) + ' / ' + clock(media.duration);\n\t\tif (text === lastText) return;\n\t\tlastText = text;\n\t\tconst now = Date.now();\n\t\tconst share = now - lastBroadcast > 2000;\n\t\tif (share) lastBroadcast = now;\n\t\tset('YT Time', 'text', text, share);\n\t}\n};"
			}
		]
