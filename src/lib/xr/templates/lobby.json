			{
				"type": "codeBlock",
				"code": "const RANGE = 1.4;          // max reach of the jet\nconst CLEAN_RADIUS = 0.17;  // per-face UV-space radius cleaned around the hit point (0-1)\nconst CLEAN_RATE = 0.55;    // fraction of coverage removed per tick within the radius\nconst SYNC_MS = 120;        // how often guests get the growing clean spot\nconst BEAM_SYNC_MS = 40;    // how often the beam's endpoints are pushed to guests\nconst ATLAS_COLS = 3;       // must match surfaceMaskRenderer.ts's box atlas layout\nconst ATLAS_ROWS = 2;\nlet spraying = false;\nlet beamId = null;\nlet lastMaskSync = 0;\nlet lastBeamSync = 0;\n\nfunction nozzlePose() {\n  const tip = ctx.hierarchy.findByName('Washer Nozzle');\n  return tip ? ctx.hierarchy.getWorldPose(tip.id) : null;\n}\n\nfunction decodeMask(b64, size) {\n  const bin = atob(b64);\n  const arr = new Uint8ClampedArray(size);\n  for (let i = 0; i < arr.length && i < bin.length; i++) arr[i] = bin.charCodeAt(i);\n  return arr;\n}\n\nfunction encodeMask(arr) {\n  let bin = '';\n  for (let i = 0; i < arr.length; i++) bin += String.fromCharCode(arr[i]);\n  return btoa(bin);\n}\n\n// Babylon's box builder order (boxBuilder.js CreateBoxVertexData's \"normals\"\n// array): +Z, -Z, +X, -X, +Y, -Y — surfaceMaskRenderer.ts's atlas cells follow\n// this same order, so identifying the hit face this way lands on the matching cell.\nfunction faceIndexFromNormal(normal, rotation) {\n  const inv = [-rotation[0], -rotation[1], -rotation[2], rotation[3]];\n  const local = ctx.math.rotateVec(inv, normal);\n  const ax = Math.abs(local[0]), ay = Math.abs(local[1]), az = Math.abs(local[2]);\n  if (az >= ax && az >= ay) return local[2] > 0 ? 0 : 1;\n  if (ax >= ay && ax >= az) return local[0] > 0 ? 2 : 3;\n  return local[1] > 0 ? 4 : 5;\n}\n\n// Erodes a surfaceMask's coverage around a raycast hit — any object with a\n// surfaceMask can be cleaned this way, not just the lobby's dirty cube. A box\n// host is laid out as a 3x2 face atlas (see surfaceMaskRenderer.ts), so the\n// hit's face is identified from its normal and mapped into that face's cell;\n// any other shape uses its single, already-unique UV region directly.\nfunction cleanAt(hit) {\n  const target = ctx.hierarchy.getSlot(hit.slotId);\n  const mask = target && target.components.find((c) => c.type === 'surfaceMask');\n  if (!mask) return;\n  const meshRef = target.components.find((c) => c.type === 'meshRenderer')?.meshRef;\n  const isBox = !!meshRef && meshRef.kind === 'builtin' && meshRef.id === 'box';\n  const cols = isBox ? ATLAS_COLS : 1;\n  const rows = isBox ? ATLAS_ROWS : 1;\n  const cell = mask.resolution;\n  const width = cell * cols;\n  const height = cell * rows;\n  const bytes = decodeMask(mask.mask, width * height);\n\n  let u = hit.u;\n  let v = hit.v;\n  if (isBox) {\n    const faceIndex = faceIndexFromNormal(hit.normal, target.rotation);\n    const col = faceIndex % ATLAS_COLS;\n    const row = Math.floor(faceIndex / ATLAS_COLS);\n    u = (col + hit.u) / ATLAS_COLS;\n    v = (row + hit.v) / ATLAS_ROWS;\n  }\n\n  const cx = u * width;\n  const cy = v * height;\n  const radiusPx = CLEAN_RADIUS * cell;\n  const minX = Math.max(0, Math.floor(cx - radiusPx));\n  const maxX = Math.min(width - 1, Math.ceil(cx + radiusPx));\n  const minY = Math.max(0, Math.floor(cy - radiusPx));\n  const maxY = Math.min(height - 1, Math.ceil(cy + radiusPx));\n  let changed = false;\n  for (let y = minY; y <= maxY; y++) {\n    for (let x = minX; x <= maxX; x++) {\n      const dx = x + 0.5 - cx;\n      const dy = y + 0.5 - cy;\n      const dist = Math.sqrt(dx * dx + dy * dy);\n      if (dist > radiusPx) continue;\n      const i = y * width + x;\n      const next = bytes[i] - 255 * CLEAN_RATE * (1 - dist / radiusPx);\n      if (next < bytes[i]) {\n        bytes[i] = next < 0 ? 0 : next;\n        changed = true;\n      }\n    }\n  }\n  if (!changed) return;\n  const now = Date.now();\n  const broadcast = now - lastMaskSync >= SYNC_MS;\n  if (broadcast) lastMaskSync = now;\n  ctx.world.setComponentField(hit.slotId, 'surfaceMask', 'mask', encodeMask(bytes), broadcast);\n}\n\nfunction beamPoints(from, to) {\n  return [from[0], from[1], from[2], to[0], to[1], to[2]];\n}\n\nfunction startBeam(from, to) {\n  beamId = crypto.randomUUID();\n  ctx.world.spawn({ id: beamId, name: 'Water Jet', components: [{ type: 'stroke', points: beamPoints(from, to), color: '#8ee3ff', width: 0.045 }] });\n  lastBeamSync = Date.now();\n}\n\nfunction updateBeam(from, to) {\n  if (!beamId) return;\n  const now = Date.now();\n  const broadcast = now - lastBeamSync >= BEAM_SYNC_MS;\n  if (broadcast) lastBeamSync = now;\n  ctx.world.setComponentField(beamId, 'stroke', 'points', beamPoints(from, to), broadcast);\n}\n\nfunction endBeam() {\n  if (beamId) ctx.world.deleteSlot(beamId);\n  beamId = null;\n}\n\nfunction spray() {\n  const pose = nozzlePose();\n  if (!pose) return;\n  const origin = ctx.math.vecAdd(pose.position, ctx.math.vecScale(pose.forward, 0.03));\n  const hit = ctx.world.raycast(origin, pose.forward, RANGE);\n  const target = hit ? hit.point : ctx.math.vecAdd(pose.position, ctx.math.vecScale(pose.forward, RANGE));\n  if (!beamId) startBeam(pose.position, target);\n  else updateBeam(pose.position, target);\n  if (hit) cleanAt(hit);\n}\n\nreturn {\n  onTrigger(e) {\n    if (e.phase === 'press') spraying = true;\n    else if (e.phase === 'release') { spraying = false; endBeam(); }\n    return true;\n  },\n  onUnequip() { spraying = false; endBeam(); },\n  tick() {\n    if (!spraying || !ctx.world.isHost()) return;\n    if (!ctx.equip.isEquipped() && !ctx.grab.isHeld()) { spraying = false; endBeam(); return; }\n    spray();\n  }\n};\n"
			}
