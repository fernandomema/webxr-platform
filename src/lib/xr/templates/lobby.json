				"code": "const COLORS = [\n  ['Red', '#ef4444'], ['Orange', '#f97316'], ['Yellow', '#facc15'], ['Green', '#22c55e'],\n  ['Cyan', '#06b6d4'], ['Blue', '#3b82f6'], ['Purple', '#a855f7'], ['White', '#f8fafc']\n];\nconst SIZES = [['Fine', 0.008], ['Medium', 0.018], ['Thick', 0.035]];\nconst MIN_STEP = 0.012;          // meters between recorded points\nconst SYNC_MS = 150;             // how often guests get the growing stroke\nconst MAX_STROKE_POINTS = 1200;  // a longer line continues in a new stroke\nconst MAX_TOTAL_POINTS = 8000;   // oldest strokes are erased past this\nlet colorIndex = 0;\nlet sizeIndex = 1;\nlet drawing = false;\nlet strokeId = null;\nlet points = [];                 // flat [x, y, z, ...] of the current stroke\nlet lastSync = 0;\nconst strokes = [];              // { id, count } oldest first\n\nfunction tipPosition() {\n  const tip = ctx.hierarchy.findByName('Brush Tip');\n  const pose = tip && ctx.hierarchy.getWorldPose(tip.id);\n  return pose ? pose.position : null;\n}\n\nfunction paintTip() {\n  const tip = ctx.hierarchy.findByName('Brush Tip');\n  if (tip) ctx.world.setComponentField(tip.id, 'meshRenderer', 'color', COLORS[colorIndex][1]);\n}\n\nconst round = (v) => Math.round(v * 1000) / 1000;\n\nfunction totalPoints() {\n  return strokes.reduce((sum, s) => sum + s.count, 0);\n}\n\nfunction beginStroke(p) {\n  strokeId = crypto.randomUUID();\n  points = [round(p[0]), round(p[1]), round(p[2])];\n  strokes.push({ id: strokeId, count: 1 });\n  ctx.world.spawn({\n    id: strokeId,\n    name: 'Brush Stroke',\n    components: [{ type: 'stroke', points: points.slice(), color: COLORS[colorIndex][1], width: SIZES[sizeIndex][1] }]\n  });\n  lastSync = Date.now();\n  while (totalPoints() > MAX_TOTAL_POINTS && strokes.length > 1) ctx.world.deleteSlot(strokes.shift().id);\n}\n\n// Updates this peer every time; guests only every SYNC_MS (or when forced).\nfunction pushPoints(force) {\n  if (!strokeId) return;\n  const now = Date.now();\n  const broadcast = force || now - lastSync >= SYNC_MS;\n  if (broadcast) lastSync = now;\n  ctx.world.setComponentField(strokeId, 'stroke', 'points', points.slice(), broadcast);\n  strokes[strokes.length - 1].count = points.length / 3;\n}\n\nfunction endStroke() {\n  if (strokeId) pushPoints(true);\n  drawing = false;\n  strokeId = null;\n  points = [];\n}\n\nreturn {\n  onSpawn() { paintTip(); },\n  onEquip() { paintTip(); },\n  onUnequip() { endStroke(); },\n  onTrigger(e) {\n    if (e.phase === 'press') {\n      const p = tipPosition();\n      if (!p) return true;\n      drawing = true;\n      beginStroke(p);\n    } else if (e.phase === 'release') {\n      endStroke();\n    }\n    return true;\n  },\n  tick() {\n    if (!drawing || !ctx.world.isHost()) return;\n    if (!ctx.equip.isEquipped() && !ctx.grab.isHeld()) { endStroke(); return; }\n    const p = tipPosition();\n    if (!p || !strokeId) return;\n    const n = points.length;\n    const from = [points[n - 3], points[n - 2], points[n - 1]];\n    if (ctx.math.vecLength(ctx.math.vecSub(p, from)) < MIN_STEP) {\n      pushPoints(false); // nothing new, but flush a pending update once SYNC_MS has passed\n      return;\n    }\n    points.push(round(p[0]), round(p[1]), round(p[2]));\n    if (points.length / 3 >= MAX_STROKE_POINTS) {\n      pushPoints(true);\n      beginStroke(p); // continue the line seamlessly in a fresh stroke\n      return;\n    }\n    pushPoints(false);\n  },\n  getRadialItems() {\n    return [\n      { label: 'Color: ' + COLORS[colorIndex][0], isEnabled: () => true, onSelect: () => { colorIndex = (colorIndex + 1) % COLORS.length; paintTip(); } },\n      { label: 'Size: ' + SIZES[sizeIndex][0], isEnabled: () => true, onSelect: () => { sizeIndex = (sizeIndex + 1) % SIZES.length; } },\n      { label: 'Clear strokes', isEnabled: () => strokes.length > 0, onSelect: () => { while (strokes.length) ctx.world.deleteSlot(strokes.pop().id); strokeId = null; points = []; } }\n    ];\n  }\n};\n"
			}
		]
	},
