# Postgres local: `npx prisma dev` imprime la URL a usar aquí
DATABASE_URL=""

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://localhost:5173"

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# STUN público por defecto si no se define
PUBLIC_STUN_URLS="stun:stun.l.google.com:19302"

# 3D model storage (any S3-compatible service: Garage, MinIO, R2, S3). The bucket must already exist.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
# auto: direct browser <-> S3 transfers when S3_ENDPOINT is https, through this server when it is http
# (a browser blocks http requests from an https page). direct | proxy force a mode.
ASSET_TRANSFER="auto"
# Per-user storage quota in bytes (each owner is charged the full size of every model they own). 0 disables it.
ASSET_USER_QUOTA_BYTES="524288000"
# Days an unreferenced model is kept before scripts/gc-assets.mjs may delete it.
ASSET_GC_GRACE_DAYS="7"
# Production only: adapter-node rejects request bodies over 512 KB unless raised; needed for proxied uploads.
# BODY_SIZE_LIMIT=26214400
# Shared secret for scripts/gc-assets.mjs (the cleanup endpoint does not exist without it).
ASSET_ADMIN_TOKEN=""
