# Postgres local: `npm run db:up` levanta el de docker-compose.yml y crea las tablas
DATABASE_URL="postgres://webxr:webxr@127.0.0.1:5440/webxr"
# Solo con `prisma dev` (PGlite, 1 conexión, se cae con escenas grandes) pon 1; con Postgres déjalo vacío
DATABASE_POOL_MAX=

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://localhost:5173"

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# STUN público por defecto si no se define
PUBLIC_STUN_URLS="stun:stun.l.google.com:19302"

# 3D model storage (any S3-compatible service: Garage, MinIO, R2, S3). The bucket must already exist.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
# Folder prepended to every object key. Defaults to "dev" in development and none in production, so one bucket can serve both. Set "" to disable.
# S3_KEY_PREFIX="dev"
# auto: direct browser <-> S3 transfers when S3_ENDPOINT is https, through this server when it is http
# (a browser blocks http requests from an https page). direct | proxy force a mode.
ASSET_TRANSFER="auto"
# Per-user storage quota in bytes (each owner is charged the full size of every model they own). 0 disables it.
ASSET_USER_QUOTA_BYTES="104857600"
# Days an unreferenced model is kept before scripts/gc-assets.mjs may delete it.
ASSET_GC_GRACE_DAYS="7"
# Production only: adapter-node rejects request bodies over 512 KB unless raised; needed for proxied uploads.
# BODY_SIZE_LIMIT=26214400
# Shared secret for scripts/gc-assets.mjs (the cleanup endpoint does not exist without it).
ASSET_ADMIN_TOKEN=""

# Optional team token for PATCH /api/feedback/:id roadmap status updates.
FEEDBACK_ADMIN_TOKEN=

# Credits. The secret signs purchase challenges (defaults to BETTER_AUTH_SECRET when empty).
CREDITS_SECRET=""
# Stripe Checkout for buying credits: the webhook endpoint is /api/credits/webhooks/stripe (events: checkout.session.completed, checkout.session.async_payment_succeeded).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Meta Quest in-app purchases (Horizon Store). Both are needed to accept receipts.
META_APP_ID=""
META_APP_SECRET=""

# Sites of games built on the engine that may call the API with a bearer token (comma-separated origins; * matches any host or port).
ENGINE_ALLOWED_ORIGINS=""

# Platform AI in the Studio (Cloudflare Workers AI, paid with credits). Without both values the "Kithin AI" provider is hidden.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_TOKEN=""
# AI Gateway name (with Unified Billing): needed for the Claude / Kimi models, which are not on Workers AI.
CLOUDFLARE_AI_GATEWAY=""
# Free for everyone (usage is still recorded to calibrate prices). Always free in development.
# PLATFORM_AI_FREE="true"
# Overrides the model list/prices: JSON array of {id,label,credits,maxCalls,maxInputTokens,maxOutputTokens}
# PLATFORM_AI_MODELS=""
# Pricing. A run costs (measured cost x (1 + FEE_PERCENT)) + FEE_USD, rounded up to whole credits. Model rates are fetched from Cloudflare /
# OpenRouter price lists and cached for hours; measured cost replaces the estimate after MIN_SAMPLES completed runs of a model.
# PLATFORM_AI_FEE_USD="0.02"
# PLATFORM_AI_FEE_PERCENT="0"
# 100 credits = 1 USD
# PLATFORM_AI_CREDIT_USD="0.01"
# PLATFORM_AI_MIN_SAMPLES="30"

# External content library (Studio: models and materials from outside sources). Comma separated; polyhaven is the default.
# LIBRARY_SOURCES="polyhaven,shep"
# shep's 3D Asset Server (https://3d.shep.bot/docs/api): the public one needs no key; point these at your own instance if you run one.
# SHEP_API_URL="https://3d.shep.bot"
# SHEP_API_KEY=""
# Its files live on each provider's own domain, so by default any public host is allowed (names that resolve to private addresses are refused).
# Set a comma separated list to allow only those hosts instead.
# SHEP_CDN_HOSTS=""
